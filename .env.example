# Copy to .env (git-ignored) and fill in. Never commit real keys, never paste them into coord/.
# Loaded by: harbor run --env-file .env ...

# Google Gemini API (sponsor credits, one form per team). Used for the agent under test:
#   harbor run -p task -a opencode -m google/gemini-4-carbon
GEMINI_API_KEY=

# Verda inference API (OpenAI-compatible, https://inference.verda.com/v1). Cheap open models
# for plumbing tests and a second model family.
VERDA_API_KEY=

# NVIDIA Nemotron 3.5 Super VL on a Verda container endpoint (OpenAI-compatible,
# https://containers.datacrunch.io/nemotron-3-5-super-vl-b300/v1). A different key from VERDA_API_KEY.
#   python3 eval/run_eval.py --task <dir> --provider nemotron
VERDA_INFERENCE_KEY=

# Featherless inference API (OpenAI-compatible, https://api.featherless.ai/v1). Small open models such
# as Qwen 3 (8B, 14B, 32B) for a weaker agent and the small-model stretch goal:
#   python3 eval/run_eval.py --provider featherless [--model featherless/Qwen/Qwen3-14B]
#   python3 eval/featherless_models.py     # which models have native tool calls and enough context
FEATHERLESS_API_KEY=

# Modal: no variable needed if you ran `.venv/bin/modal token new` (writes ~/.modal.toml).
# Otherwise set both:
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Optional. Codex usage credits (ChatGPT account, not API credits) only work with Harbor's
# `codex` agent: run `codex login` once, then point at the file. Keep runs serial.
# CODEX_AUTH_JSON_PATH=/home/you/.codex/auth.json
